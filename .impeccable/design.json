    {
      "name": "Category Navigation",
      "kind": "nav",
      "refersTo": "category-nav",
      "description": "Home-first, horizontally scrolling navigation followed by the six ordered categories, with a current-page underline.",
      "html": "<nav class=\"ds-category-nav\" aria-label=\"News categories\"><a href=\"/\" aria-current=\"page\">Home</a><a href=\"/india\">India</a><a href=\"/business\">Business</a><a href=\"/technology\">Technology</a><a href=\"/sports\">Sports</a><a href=\"/entertainment\">Entertainment</a><a href=\"/belgaum\">Belgaum</a></nav>",
      "css": ".ds-category-nav{display:flex;gap:28px;overflow-x:auto;padding:0 24px;border-bottom:1px solid var(--hairline,#DEE5F0);background:var(--surface,#FFFFFF);font-family:var(--font-source,\"Source Sans 3\"),Arial,sans-serif;}.ds-category-nav a{position:relative;display:inline-flex;align-items:center;min-height:48px;flex-shrink:0;color:var(--ink,#17243E);font-size:16px;text-decoration:none;}.ds-category-nav a:hover,.ds-category-nav a[aria-current]{color:var(--primary,#2F4BEB);}.ds-category-nav a[aria-current]{font-weight:700;}.ds-category-nav a[aria-current]::after{content:\"\";position:absolute;bottom:0;left:0;right:0;height:3px;background:var(--primary,#2F4BEB);}.ds-category-nav a:focus-visible{outline:3px solid var(--primary,#2F4BEB);outline-offset:4px;}@media(max-width:1023px){.ds-category-nav{gap:26px;padding-inline:16px;}.ds-category-nav a{min-height:44px;}}"
