      "html": "<div class=\"ds-field\"><label for=\"ds-search\">Search news</label><input id=\"ds-search\" class=\"ds-input\" type=\"search\" placeholder=\"Search headlines\" /></div>",
      "css": ".ds-field{width:min(360px,100%);font-family:var(--font-source,\"Source Sans 3\"),Arial,sans-serif;color:var(--ink,#17243E);}.ds-field label{display:block;font-size:14px;font-weight:500;margin-bottom:6px;color:var(--color-gray-700,#334763);}.ds-input{display:block;width:100%;min-height:44px;padding:10px 16px;border:1px solid var(--color-gray-300,#C5CFDF);border-radius:8px;background:var(--surface,#FFFFFF);color:var(--ink,#17243E);font-size:16px;font-family:var(--font-source,\"Source Sans 3\"),Arial,sans-serif;transition:all .2s;}.ds-input::placeholder{color:var(--muted,#5E6D85);}.ds-input:hover{border-color:var(--muted,#5E6D85);}.ds-input:focus{outline:none;box-shadow:0 0 0 2px var(--color-blue-500,oklch(62.3% 0.214 259.815));border-color:transparent;}.ds-input[aria-invalid=\"true\"]{border-color:var(--color-red-500,oklch(63.7% 0.237 25.331));}.ds-input[aria-invalid=\"true\"]:focus{box-shadow:0 0 0 2px var(--color-red-500,oklch(63.7% 0.237 25.331));}.ds-input:disabled{opacity:.48;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-input{transition-duration:.01ms;}}"
