      "css": ".ds-button-primary{display:inline-flex;min-height:44px;align-items:center;justify-content:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:14px;font-weight:600;line-height:20px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;font-family:var(--font-source,\"Source Sans 3\"),Arial,sans-serif;background:#2F4BEB;color:#FFFFFF;border:0;}.ds-button-primary:hover:not(:disabled){background:#243AC4;}.ds-button-primary:focus-visible{outline:3px solid var(--primary,#2F4BEB);outline-offset:3px;}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:.01ms;}}"
